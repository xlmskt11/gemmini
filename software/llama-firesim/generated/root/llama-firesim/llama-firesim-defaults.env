LLAMA_FIRESIM_HW_PROFILE=multi
: "${LLAMA_FIRESIM_MODE:=repl}"
: "${LLAMA_FIRESIM_SWEEP_PROMPT_MIN:=64}"
: "${LLAMA_FIRESIM_SWEEP_PROMPT_MAX:=256}"
: "${LLAMA_FIRESIM_SWEEP_PROMPT_STEP:=16}"
: "${LLAMA_FIRESIM_SWEEP_MASKS:=1,3,7,15}"
: "${LLAMA_FIRESIM_N_PREDICT:=16}"
: "${GGML_GEMMINI_ACTIVE_MASK:=0xf}"
: "${GGML_GEMMINI_PAGE_PACKED_A:=0}"
: "${GGML_GEMMINI_PAGE_PACKED_B:=1}"
: "${GGML_GEMMINI_PAGE_PACKED_C:=0}"
: "${GGML_GEMMINI_PAGE_PACKED_D:=0}"
: "${Flash_Q_PAGE_PACKED:=${FLASH_Q_PAGE_PACKED:-0}}"
: "${Flash_K_PAGE_PACKED:=${FLASH_K_PAGE_PACKED:-0}}"
: "${Flash_V_PAGE_PACKED:=${FLASH_V_PAGE_PACKED:-0}}"
export LLAMA_FIRESIM_MODE
export LLAMA_FIRESIM_HW_PROFILE
export LLAMA_FIRESIM_SWEEP_PROMPT_MIN
export LLAMA_FIRESIM_SWEEP_PROMPT_MAX
export LLAMA_FIRESIM_SWEEP_PROMPT_STEP
export LLAMA_FIRESIM_SWEEP_MASKS
export LLAMA_FIRESIM_N_PREDICT
export GGML_GEMMINI_ACTIVE_MASK
export GGML_GEMMINI_PAGE_PACKED_A
export GGML_GEMMINI_PAGE_PACKED_B
export GGML_GEMMINI_PAGE_PACKED_C
export GGML_GEMMINI_PAGE_PACKED_D
export Flash_Q_PAGE_PACKED
export Flash_K_PAGE_PACKED
export Flash_V_PAGE_PACKED
